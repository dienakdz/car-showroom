APP_NAME="MD-CARS Showroom"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8889

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=car_showroom
DB_USERNAME=car
DB_PASSWORD=car

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Showroom Configuration
DEFAULT_CUSTOMER_PASSWORD=Auto123
CAR_MEDIA_MAX_WIDTH=1280
CAR_MEDIA_MAX_HEIGHT=720
CAR_MEDIA_JPEG_QUALITY=90
VIEW_DATA_CACHE_STORE=file
SHOWROOM_PAGINATION_CLIENT=12
SHOWROOM_PAGINATION_ADMIN=12
THROTTLE_APPOINTMENTS_PER_MINUTE=10
THROTTLE_LEADS_PER_MINUTE=15

# Internal Python car-search service
CAR_SEARCH_URL=http://car-search:8000
CAR_SEARCH_API_TOKEN=local-car-search-token
CAR_SEARCH_CONNECT_TIMEOUT=1
CAR_SEARCH_TIMEOUT=3
CAR_SEARCH_RESULT_LIMIT=100
